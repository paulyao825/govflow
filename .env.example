# TypeSafe Jev (System One) — https://console.typesafe.ai/keys
# Without it, decisions run on a clearly-labelled deterministic SIMULATOR (never presented as Jev).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# OpenAI — conversational orchestrator + Traditional-Chinese drafting.
# Without it (or if the call fails), drafts use labelled templates and chat uses a rule-based intent router.
OPENAI_API_KEY=
# Optional: takes precedence over OPENAI_API_KEY (useful if a stale key is exported in your shell)
GOVFLOW_OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Firestore persistence (server-side, firebase-admin). base64 of the service-account JSON.
# Without it, state lives in memory (fine for local `next dev`, not for Vercel).
FIREBASE_SERVICE_ACCOUNT_B64=
# Public Firebase web config (JSON, single line) for realtime onSnapshot in the browser. Rules allow read-only.
NEXT_PUBLIC_FIREBASE_CONFIG=

# Demo pacing between tool steps so humans can follow the stream. Excluded from reported agent time.
DEMO_STEP_DELAY_MS=450
# Test switch: force Jev failures to verify fail-safe escalation.
JEV_FORCE_FAIL=
